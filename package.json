{
  "name": "meridian-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meridian Life Sciences enterprise AI usage and capability platform",
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/admin/e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start:admin": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ./scripts/register-ts.mjs apps/admin/src/main.ts",
    "validate:provisioning": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ./scripts/register-ts.mjs scripts/validate-provisioning.ts",
    "test:e2e": "playwright test -c apps/admin/e2e/playwright.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
